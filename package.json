{
  "name": "@gate/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runs a pull request's preview build inside a hardened sandbox and publishes a design review as a sticky PR comment plus a Check Run",
  "license": "MIT",
  "author": "Aditya Prathapa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apatureai/gate.git"
  },
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "demo": "tsc -b packages/action && node packages/action/dist/supervisor-demo-cli.js",
    "demo:review": "tsc -b packages/action && node packages/action/dist/review-demo-cli.js",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "4.1.10"
  }
}
