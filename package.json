{
  "name": "@gate/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Apature Gate - judgment-only design review for GitHub PRs",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "^5.11.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
