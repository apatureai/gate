# Docker image for the Apature Gate GitHub Action (Action path).
# Judgment-only: posts comments + check runs; never writes repo contents.
FROM node:24-trixie-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
# Pin a Node-24-compatible npm release whose bundled Undici is patched.
RUN npm install --global npm@11.18.0 && corepack enable
WORKDIR /app

FROM base AS build
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json tsconfig.json ./
COPY packages ./packages
RUN pnpm install --frozen-lockfile
RUN pnpm build

FROM build AS prune
RUN rm -rf node_modules packages/*/node_modules \
  && pnpm install --prod --offline --frozen-lockfile

FROM base AS runtime
ENV NODE_ENV=production
# tini as PID 1 (#70 DR-2): forwards SIGTERM to the action so a cancelled job
# tears down the local-serve process tree, and reaps any zombies the
# preview-command leaves behind. Without an init, PID 1 ignores SIGTERM and
# orphaned children can linger.
RUN apt-get update && apt-get install -y --no-install-recommends liblzma5 tini \
  && rm -rf /var/lib/apt/lists/*
COPY --from=prune /app/node_modules ./node_modules
COPY --from=prune /app/packages ./packages
COPY --from=prune /app/package.json ./package.json
COPY --from=prune /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
# The entrypoint script path MUST be absolute. GitHub runs a Docker action with
# `--workdir /github/workspace` (the ADOPTER's checkout), which overrides this
# image's WORKDIR at runtime. A relative `packages/action/dist/main.js` then
# resolves against the adopter's tree — which does not contain Gate's code — and
# every install crashes with "Cannot find module
# /github/workspace/packages/action/dist/main.js" before it can publish even the
# neutral "Engine not configured" Check Run. `/app` is where the runtime stage
# COPYs the compiled app, so anchor the script there and let cwd stay on the
# checkout (main.ts reads .gate.yml / package.json relative to cwd, on purpose).
# Node resolves node_modules from the script's own directory up to /app, so
# imports work regardless of cwd. See scripts/e2e/install-path.mjs, which proves
# this from a foreign layout in CI (install-path-e2e).
ENTRYPOINT ["/usr/bin/tini", "--", "node", "/app/packages/action/dist/main.js"]
