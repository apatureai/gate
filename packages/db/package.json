{
  "name": "@gate/db",
  "version": "0.1.0",
  "private": true,
  "description": "Gate durable product state: Postgres schema + idempotent migration runner.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tenant": {
      "types": "./dist/tenant.d.ts",
      "default": "./dist/tenant.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "migrate": "node ./dist/cli/migrate.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/pg": "^8.11.10",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4"
  }
}
